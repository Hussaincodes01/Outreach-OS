# Production environment template for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production   (then fill in real secrets)
#
# Read by every app service via `env_file`. Host-specific URLs (DATABASE_URL,
# REDIS_URL, CELERY_*) are set by the compose file and must NOT be set here.
# Generate strong secrets — the API refuses to boot in production with weak
# or missing values (see outreach_os.core.config).

ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Auth ---
# Strong random string, >= 32 chars. e.g. `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_long_random_secret
JWT_ALG=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Credential vault ---
# Base64 Fernet key (decodes to 32 bytes). e.g. `openssl rand -base64 32`
VAULT_MASTER_KEY=CHANGE_ME_base64_fernet_key

# --- CORS (REQUIRED) ---
# Comma-separated browser origins allowed to call the API. Without this the
# web app cannot make authenticated cross-origin requests.
CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Public URLs ---
# Public base URL of the API — used for tracking pixels and unsubscribe links.
PUBLIC_BASE_URL=https://api.example.com
# Baked into the web client bundle at build time (browser -> API).
NEXT_PUBLIC_API_URL=https://api.example.com
NEXTAUTH_URL=https://app.example.com
NEXTAUTH_SECRET=CHANGE_ME_long_random_secret

# --- Inbound reply webhook (REQUIRED) ---
# HMAC-SHA256 secret used to verify inbound reply webhook bodies.
INBOUND_WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# Background tasks run on the worker, never inline, in production.
CELERY_TASK_ALWAYS_EAGER=false

# --- Object storage (S3 / MinIO) ---
S3_ENDPOINT_URL=
S3_BUCKET=outreach
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=us-east-1

# --- Transactional SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Billing ---
# "stub" (no external calls) or "stripe". If "stripe", the two keys are required.
BILLING_PROVIDER=stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- LLM / OAuth (fill in as needed) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# --- Error monitoring ---
SENTRY_DSN=
