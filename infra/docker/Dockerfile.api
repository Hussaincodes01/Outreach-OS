# Multi-stage build for the FastAPI backend.
# Build context MUST be the repository root (the COPY paths below are
# repo-relative), e.g.  `docker build -f infra/docker/Dockerfile.api .`
#
# Stage 1: build a wheel + install deps into an isolated prefix we can copy.
# Stage 2: slim runtime image.

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /src

# System deps for asyncpg / cryptography wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# The package metadata declares `readme = "../../README.md"`, so the build
# needs the repo-root README *and* the full apps/api source tree (hatchling
# builds the wheel from src/outreach_os). Preserve the monorepo layout.
COPY README.md ./README.md
COPY apps/api ./apps/api

RUN pip install --upgrade pip && \
    pip install --prefix=/install "./apps/api[prod]"

# Stage 2: runtime
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GUNICORN_WORKERS=4

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 app

# Installed package + console scripts (gunicorn, uvicorn, alembic) land on
# the standard prefix, so they are already on PATH / sys.path.
COPY --from=builder /install /usr/local
# Source is still needed at runtime for Alembic migrations (alembic/, alembic.ini).
COPY apps/api /app

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

# Run under gunicorn with uvicorn workers (production-grade process manager).
# --forwarded-allow-ips=* trusts X-Forwarded-* from the upstream load balancer
# so request.url / HTTPS detection work behind a proxy.
CMD ["sh", "-c", "exec gunicorn outreach_os.main:app -k uvicorn.workers.UvicornWorker -b 0.0.0.0:8000 --workers ${GUNICORN_WORKERS:-4} --forwarded-allow-ips='*' --access-logfile - --error-logfile -"]
