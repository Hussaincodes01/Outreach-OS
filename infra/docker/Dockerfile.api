# Multi-stage build for the FastAPI backend.
# Build context MUST be the repository root (the COPY paths below are
# repo-relative), e.g.  `docker build -f infra/docker/Dockerfile.api .`
#
# Stage 1: build a wheel + install deps into an isolated prefix we can copy.
# Stage 2: slim runtime image.

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /src

# System deps for asyncpg / cryptography wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api ./apps/api

RUN pip install --upgrade pip && \
    pip install --prefix=/install "./apps/api[prod]"

# Stage 2: runtime
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GUNICORN_WORKERS=4

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    # Chromium deps for Scrapling StealthyFetcher (anti-bot fallback)
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    libxshmfence1 \
    fonts-liberation \
    wget \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 app

# Installed package + console scripts (gunicorn, uvicorn, alembic) land on
# the standard prefix, so they are already on PATH / sys.path.
COPY --from=builder /install /usr/local

# Download Chromium for Scrapling's StealthyFetcher (anti-bot fallback).
# The primary Fetcher doesn't need a browser — this is only for sites
# that block HTTP requests with Cloudflare/captcha.
#
# We invoke playwright directly instead of `scrapling install`, because that
# wrapper also runs `playwright install-deps`, which apt-installs system
# libraries and so requires root. Those libraries are already installed above,
# making the step both redundant and fatal here.
#
# PLAYWRIGHT_BROWSERS_PATH puts the browser in a shared location rather than
# $HOME/.cache. Downloading into root's home would leave it unreadable by the
# unprivileged `app` user, and StealthyFetcher would fail at runtime with
# "browser executable not found". The ENV persists into the running container,
# so the app resolves the same path.
#
# Kept ABOVE the source COPY: the download depends only on the installed
# packages, so editing application code would otherwise invalidate this layer
# and re-fetch ~200 MB on every build.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN python -m playwright install chromium \
    && chmod -R a+rX /ms-playwright

# Source is still needed at runtime for Alembic migrations (alembic/, alembic.ini).
COPY apps/api /app

USER app
ENV HOME=/home/app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

# Run under gunicorn with uvicorn workers (production-grade process manager).
# --forwarded-allow-ips=* trusts X-Forwarded-* from the upstream load balancer
# so request.url / HTTPS detection work behind a proxy.
CMD ["sh", "-c", "exec gunicorn outreach_os.main:app -k uvicorn.workers.UvicornWorker -b 0.0.0.0:8000 --workers ${GUNICORN_WORKERS:-4} --forwarded-allow-ips='*' --access-logfile - --error-logfile -"]
