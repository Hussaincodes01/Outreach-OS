{
  "name": "outreach-os",
  "version": "0.1.0",
  "private": true,
  "description": "Outreach OS monorepo (SaaS build, OSS release planned later).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:infra": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "dev:api": "npm run dev --workspace=@outreach-os/api",
    "dev:web": "npm run dev --workspace=@outreach-os/web",
    "test:api": "npm run test --workspace=@outreach-os/api",
    "lint:api": "npm run lint --workspace=@outreach-os/api",
    "typecheck:api": "npm run typecheck --workspace=@outreach-os/api",
    "build:api": "npm run build --workspace=@outreach-os/api",
    "build:web": "npm run build --workspace=@outreach-os/web",
    "codegen:web": "bash scripts/generate-api-client.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
