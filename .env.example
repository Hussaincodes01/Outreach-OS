# Outreach OS local development environment
# Copy this file to .env and replace placeholders with local-only values.
# Never commit a real .env file.

ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/outreach
DATABASE_URL_SYNC=postgresql://USER:PASSWORD@localhost:5432/outreach
DATABASE_URL_ADMIN=postgresql+asyncpg://ADMIN_USER:ADMIN_PASSWORD@localhost:5432/outreach
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/outreach_test
TEST_DATABASE_URL_ADMIN=postgresql+asyncpg://ADMIN_USER:ADMIN_PASSWORD@localhost:5432/outreach_test

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALG=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

# Credential encryption
VAULT_MASTER_KEY=replace-with-a-fernet-compatible-key

# Logging
LOG_LEVEL=INFO

# Web app
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
