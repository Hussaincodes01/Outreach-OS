# Outreach OS — single-user, one-command stack.
#
# One-command flow:
#   1. npm run setup   -- creates .env from this file (if missing) and fills
#                          VAULT_MASTER_KEY / INBOUND_WEBHOOK_SECRET if blank.
#   2. Add your LLM/scraping provider keys below (optional — the app runs
#      without them; draft generation just returns 428 until one is set).
#   3. npm start        -- docker compose up -d --build (brings up Postgres,
#                          Redis, MinIO, migrate, api, worker, beat, web).
#
# The values below are for RUNNING ON THE HOST (e.g. `npm run dev:*`). Inside
# the Docker Compose stack, docker-compose.yml overrides the DB/Redis/S3 URLs
# to point at the container network instead of localhost.
#
# Never commit a real .env file.

ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5433/outreach
DATABASE_URL_SYNC=postgresql://USER:PASSWORD@localhost:5433/outreach
DATABASE_URL_ADMIN=postgresql+asyncpg://ADMIN_USER:ADMIN_PASSWORD@localhost:5433/outreach
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5433/outreach_test
TEST_DATABASE_URL_ADMIN=postgresql+asyncpg://ADMIN_USER:ADMIN_PASSWORD@localhost:5433/outreach_test

# Redis / Celery
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# CORS — comma-separated browser origins allowed to call the API.
# Local dev adds http://localhost:3000 automatically; REQUIRED in production.
CORS_ALLOWED_ORIGINS=

# Network exposure. There is no login, so the stack is localhost-only by default.
# BIND_ADDRESS: host interface docker compose publishes api (8000), web (3000)
#   and greenmail (3025/3143) on. Default 127.0.0.1. Set 0.0.0.0 (or one LAN
#   IP) only on a trusted network, ideally behind an authenticating proxy.
# ALLOWED_HOSTS: comma-separated hostnames the API answers to; any other Host
#   header gets a 400. Default localhost,127.0.0.1. For LAN access add the
#   name/IP you browse to (e.g. localhost,127.0.0.1,192.168.1.20) and rebuild
#   the web image with NEXT_PUBLIC_API_URL pointing at that address.
BIND_ADDRESS=127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Inbound reply webhook HMAC secret (REQUIRED in production).
INBOUND_WEBHOOK_SECRET=

# Public base URL for tracking/unsubscribe links (set to your domain in prod).
PUBLIC_BASE_URL=http://localhost:8000

# Credential encryption
VAULT_MASTER_KEY=replace-with-a-fernet-compatible-key

# LLM provider keys — set the one(s) you use and restart the API. A key set
# here takes precedence over one saved through Settings -> Integrations.
# Base URL vars are only needed for gateway / self-hosted providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
TOGETHER_AI_API_KEY=
FIREWORKS_AI_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_LIKE_API_KEY=
OPENAI_LIKE_API_BASE=
OLLAMA_API_KEY=
OLLAMA_API_BASE=

# Scraping / enrichment keys — same precedence as the LLM keys above.
SERPER_API_KEY=
PROXYCURL_API_KEY=
RAPIDAPI_API_KEY=
SCRAPINGBEE_API_KEY=

# Logging
LOG_LEVEL=INFO

# Web app
NEXT_PUBLIC_API_URL=http://localhost:8000
